// ─────────────────────────────────────────────────────────────────────────────
// OpenSessions — SessionBoard clone. Database schema (design source of truth).
//
// Target: SQLite. NOTE: Prisma does not support native enums on SQLite; this
// file is the design artifact. The implementation translates 1:1 to drizzle
// with `text('col', { enum: [...] })` columns. Enum names/values are final.
//
// Scope: events, form builder (conditional logic + routing), submissions
// (abstract → session lifecycle), evaluation (rounds/scorecards/reviews),
// agenda (drafts/placements/rules), speaker portal (tasks, file requests,
// files), emails (templates/reminders/log/ICS), embeds.
// Out of scope per brief: CRM, CMS pages, payments, marketing, sponsors.
//
// ── Constraints Prisma cannot express (added in the drizzle/SQL migration) ──
// Partial unique indexes (SQLite treats each NULL as distinct in UNIQUE):
//   task_assignment(task_definition_id, speaker_id)            WHERE session_id IS NULL
//   task_assignment(task_definition_id, speaker_id, session_id) WHERE session_id IS NOT NULL
//   form_field_value(response_id, name, value)          WHERE subject_speaker_id IS NULL
//   form_field_value(response_id, name, value, subject_speaker_id)
//                                                       WHERE subject_speaker_id IS NOT NULL
//   speaker(event_id, user_id)                          WHERE user_id IS NOT NULL
//   org(owner_user_id)                                  WHERE kind = 'personal'
// CHECK constraints:
//   session:          status = 'DRAFT' OR length(trim(title)) > 0
//   session:          (starts_at IS NULL AND ends_at IS NULL) OR ends_at > starts_at
//   draft_placement:  (starts_at IS NULL AND ends_at IS NULL) OR ends_at > starts_at
//   embed_filter:     exactly one of track_id/tag_id/format_id
//   lifecycle enums:  CHECK(col IN (...)) on all status/stage columns (drizzle
//                     text enums are TypeScript-only; SQLite needs the CHECK)
// Composite FKs on NULLABLE columns (Prisma forbids mixed required/optional
// relation fields; drizzle adds these directly — enforced only when non-null):
//   session(track_id, event_id)   → track(id, event_id)     (same for format,
//   level, language, room, form, submitter_speaker, evaluation_plan, slot)
//   task_assignment(session_id, event_id) → session(id, event_id)
// Every event-scoped parent exposes UNIQUE(id, event_id) to support these.
// ─────────────────────────────────────────────────────────────────────────────

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ═════════════════════════════════════════════════════════════════════════════
// AUTH + ORGS — ported 1:1 from the akarso project (db/src/schema.ts), which
// this codebase is built on. akarso runs BetterAuth on D1/SQLite via drizzle.
// One User table serves BOTH organizers and submitters/speakers. Organizers
// get OrgMember + EventMember rows; submitters get Speaker rows.
//
// Porting rules (keep identical to akarso so its code ports unchanged):
// - Physical table names: user / session / account / verification /
//   org / org_member / org_invitation (see @@map). Because BetterAuth owns
//   the `session` table, the DOMAIN session entity maps to `event_session`.
// - IDs are ULIDs via drizzle `$defaultFn(() => ulid())` (@default(cuid())
//   below is the Prisma-side stand-in; the implementation uses ulid()).
// - Timestamps are the akarso `epochMs` custom type (epoch ms integers that
//   accept Date in toDriver — required for BetterAuth on D1).
// - Enum values are lowercase text enums exactly as in akarso.
// - Auth tables are BetterAuth-shaped (plugins here: magic-link; akarso's
//   deviceCode/mcp/apikey plugin tables are not ported — not needed).
// - Org semantics (akarso/sigillo-style): every user gets exactly ONE
//   'personal' org auto-created race-safe via the partial unique index
//   org_owner_personal_unique ON org(owner_user_id) WHERE kind = 'personal';
//   the owner can never leave or be removed from it, so a deterministic
//   default org always exists. 'team' orgs are created explicitly.
//   Invitations are secret links (no email, no status; valid until
//   expiresAt so a page re-render after accept still shows success);
//   acceptance is idempotent via the unique (orgId, userId) member index.
// ═════════════════════════════════════════════════════════════════════════════

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  authSessions      AuthSession[]
  authAccounts      AuthAccount[]
  ownedOrgs         Org[]
  memberships       OrgMember[]
  invitationsCreated OrgInvitation[]
  eventMemberships  EventMember[]
  speakerIdentities Speaker[] // linked speaker rows across events
  reviewAssignments ReviewAssignment[]
  reviewerPools     EvaluationRoundReviewer[]
  formNotifications FormNotificationRecipient[]

  @@map("user")
}

model AuthSession {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session") // BetterAuth owns the physical `session` table
}

model AuthAccount {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String // provider account id
  providerId            String // "credential" | "google" | "magic-link" | ...
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String? // hashed, for credential provider
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// 'personal' orgs are auto-created, one per user, undeletable defaults.
// 'team' orgs are created explicitly from the org switcher.
enum OrgKind {
  personal
  team
}

enum OrgMemberRole {
  admin
  member
}

// The billing and membership entity — akarso shape minus billing fields
// (stripeCustomerId/subscription are out of scope per the brief). Events
// hang off the org the way akarso's profiles do.
model Org {
  orgId       String   @id @default(cuid())
  // Creator and (for personal orgs) permanent owner.
  ownerUserId String
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  kind        OrgKind  @default(personal)
  // Display name shown in the dashboard org switcher. Defaults to the
  // owner's name on creation; editable later.
  name        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     OrgMember[]
  invitations OrgInvitation[]
  events      Event[]

  // + partial unique org_owner_personal_unique ON (ownerUserId)
  //   WHERE kind = 'personal' — one personal org per user; the backbone of
  //   race-safe auto-creation and deterministic default-org resolution
  //   (see header appendix).
  @@index([ownerUserId])
  @@map("org")
}

// Junction table between users and orgs, akarso/sigillo-style. Admins manage
// invites, roles, member removal; members use everything else. The unique
// (orgId, userId) index makes invite acceptance idempotent via
// onConflictDoNothing.
model OrgMember {
  memberId  String        @id @default(cuid())
  orgId     String
  org       Org           @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      OrgMemberRole @default(member)
  createdAt DateTime      @default(now())

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
  @@map("org_member")
}

// Secret invite links (akarso/sigillo-style): anyone with the link can join
// the org after signing in. No email column — not tied to a specific user.
// No status column — the row stays valid until expiresAt so a page re-render
// after accept doesn't show "invalid invitation".
model OrgInvitation {
  invitationId String        @id @default(cuid())
  orgId        String
  org          Org           @relation(fields: [orgId], references: [orgId], onDelete: Cascade)
  role         OrgMemberRole @default(member)
  createdBy    String
  creator      User          @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime      @default(now())

  @@index([orgId])
  @@map("org_invitation")
}

// ═════════════════════════════════════════════════════════════════════════════
// EVENT + per-event team
// ═════════════════════════════════════════════════════════════════════════════

enum EventStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum EventType {
  CONFERENCE
  SUMMIT
  MEETUP
  HACKATHON
  WORKSHOP
  OTHER
}

// Shared ENABLED/DISABLED switch for rule-like rows (scheduling rules,
// reminder rules) — enum instead of a boolean so states stay extensible.
enum RuleStatus {
  ENABLED
  DISABLED
}

model Event {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [orgId], onDelete: Cascade)

  name        String
  slug        String      @unique // public CFP/portal/embed URLs
  status      EventStatus @default(DRAFT)
  eventType   EventType   @default(CONFERENCE)
  websiteUrl  String?
  location    String?
  timezone    String // IANA, e.g. "America/Los_Angeles" — agenda renders in this tz
  startsAt    DateTime
  endsAt      DateTime
  description String?
  logoFileId       String? @unique
  logoFile         File?   @relation("EventLogo", fields: [logoFileId], references: [id])
  backgroundFileId String? @unique
  backgroundFile   File?   @relation("EventBackground", fields: [backgroundFileId], references: [id])

  // Event-level default; Form.submissionLimit overrides per form. Counts drafts too.
  submissionLimitPerUser Int @default(3)

  // Race-safe friendlyId allocation: UPDATE ... SET next_session_number =
  // next_session_number + 1 RETURNING; never SELECT max()+1.
  nextSessionNumber Int @default(1)
  // Optimistic concurrency for agenda commits: bumped on every commit;
  // a draft may only commit when its baseScheduleRevision still matches.
  scheduleRevision  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members          EventMember[]
  tracks           Track[]
  formats          Format[]
  levels           Level[]
  languages        Language[]
  tags             Tag[]
  rooms            Room[]
  participantRoles ParticipantRole[]
  forms            Form[]
  speakers         Speaker[]
  sessions         Session[]
  evaluationPlans  EvaluationPlan[]
  agendaDrafts     AgendaDraft[]
  schedulingRules  SchedulingRule[]
  scheduleSlots    ScheduleSlot[]
  taskDefinitions  TaskDefinition[]
  fileRequests     FileRequest[]
  files            File[]
  emailTemplates   EmailTemplate[]
  reminderRules    ReminderRule[]
  emailMessages    EmailMessage[]
  embeds           Embed[]

  @@index([orgId])
}

enum EventRole {
  ORGANIZER // full event admin
  REVIEWER  // can only see/score assigned submissions
}

model EventMember {
  id        String    @id @default(cuid())
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      EventRole @default(ORGANIZER)
  createdAt DateTime  @default(now())

  // A user can hold several roles (e.g. ORGANIZER and REVIEWER).
  @@unique([eventId, userId, role])
  @@index([userId])
}

// ═════════════════════════════════════════════════════════════════════════════
// EVENT LIBRARY — option sources for dropdowns, agenda dimensions, roles,
// and the custom-field catalog. Mirrors SessionBoard "Settings > Library".
// ═════════════════════════════════════════════════════════════════════════════

model Track {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  color     String // hex, used by agenda + embeds
  // Category routing: submissions choosing this track land in this evaluation
  // plan (overrides Form.defaultEvaluationPlanId).
  evaluationPlanId String?
  evaluationPlan   EvaluationPlan? @relation(fields: [evaluationPlanId], references: [id], onDelete: SetNull)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  sessions     Session[]
  embedFilters EmbedFilter[]

  @@unique([eventId, name])
  @@unique([id, eventId]) // target for composite tenant-boundary FKs
  @@index([eventId])
}

model Format {
  id        String @id @default(cuid())
  eventId   String
  event     Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String // "Talk", "Workshop", "Panel", "Keynote", "Lightning"
  // Sessionize-style: agenda builder pre-fills endsAt from startsAt + duration.
  defaultDurationMinutes Int?
  sortOrder Int    @default(0)

  sessions     Session[]
  embedFilters EmbedFilter[]

  @@unique([eventId, name])
  @@unique([id, eventId])
  @@index([eventId])
}

model Level {
  id        String @id @default(cuid())
  eventId   String
  event     Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String // "Beginner", "Intermediate", "Advanced"
  sortOrder Int    @default(0)

  sessions Session[]

  @@unique([eventId, name])
  @@unique([id, eventId])
  @@index([eventId])
}

model Language {
  id        String @id @default(cuid())
  eventId   String
  event     Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int    @default(0)

  sessions Session[]

  @@unique([eventId, name])
  @@unique([id, eventId])
  @@index([eventId])
}

model Tag {
  id        String @id @default(cuid())
  eventId   String
  event     Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int    @default(0)

  sessionTags  SessionTag[]
  embedFilters EmbedFilter[]

  @@unique([eventId, name])
  @@unique([id, eventId])
  @@index([eventId])
}

model Room {
  id        String @id @default(cuid())
  eventId   String
  event     Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String // "Main Stage", "Hall A"
  capacity  Int?
  sortOrder Int    @default(0)

  sessions        Session[]
  draftPlacements DraftPlacement[]
  schedulingRules SchedulingRule[]

  @@unique([eventId, name])
  @@unique([id, eventId])
  @@index([eventId])
}

// Sessionize-style reusable time slots ("Day 1, 09:00–09:30"). The agenda
// builder snaps CONTENT sessions to slots; workshops can override with free
// timestamps. Slots are an assist, not a constraint.
model ScheduleSlot {
  id       String   @id @default(cuid())
  eventId  String
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name     String? // "Morning keynote block"
  startsAt DateTime
  endsAt   DateTime
  sortOrder Int     @default(0)

  sessions        Session[]
  draftPlacements DraftPlacement[]

  @@unique([id, eventId])
  @@index([eventId, startsAt])
}

enum CoreRole {
  SPEAKER
  CHAIRPERSON
  MODERATOR
}

// Per-event configurable participant roles ("Speakers", "Unconfirmed Speakers"...)
// each mapped to a core behavior.
model ParticipantRole {
  id         String   @id @default(cuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name       String // singular label
  namePlural String
  coreRole   CoreRole @default(SPEAKER)
  sortOrder  Int      @default(0)

  participants SessionParticipant[]

  @@unique([eventId, name])
  @@unique([id, eventId])
  @@index([eventId])
}

// ═════════════════════════════════════════════════════════════════════════════
// FORMS — MDX documents rendered with safe-mdx. There is NO form builder and
// NO structural tables: the whole form (copy, layout, field components,
// conditional logic) is one MDX source per FormVersion.
//
//   <TextField name="title" label="Session title" required maxLength={80} />
//   <Select name="track" label="Track" options={tracks} />
//   {values.format === 'workshop' && <TextField name="duration" required />}
//   <Participants min={1} max={3}>
//     <TextField name="speaker.firstName" required />
//     <RichText name="speaker.bio" maxLength={5000} />
//     <FileUpload name="speaker.headshot" accept="image/*" />
//   </Participants>
//
// Rendering: safe-mdx with { values, tracks, formats, levels, languages,
// tags } in scope; conditional logic is plain MDX expressions evaluated by
// safe-mdx's safe AST interpreter (no eval, Workers-compatible).
//
// The `name` prop is the data contract:
//   well-known names       → typed entity columns on submit
//     "title" "description" "track" "format" "level" "language" "capacity"
//     "speaker.firstName" "speaker.bio" "speaker.headshot" ...
//   any other name         → stays as FormFieldValue KV rows (custom data)
//
// Server-side validation: on submit the server re-renders the response's
// FormVersion.mdxSource with the submitted values in scope, collects the
// VISIBLE field components + their props (required, maxLength, options), and
// validates — the same conditional logic the user saw, enforced server-side.
//
// Editing: Monaco editor with a starter template + live preview. Saving
// creates a new FormVersion; responses keep the version they were filled
// against, so renaming a `name` prop never corrupts old data (the editor
// warns when a name disappears between versions).
// ═════════════════════════════════════════════════════════════════════════════

enum FormPurpose {
  CFP    // public call-for-speakers form; creates a Session (stage ABSTRACT)
  PORTAL // assigned to speakers via tasks; fills speaker or submission data
}

enum FormTarget {
  SUBMISSION // portal form about a specific session
  SPEAKER    // portal form about the speaker/contact
}

enum FormStatus {
  DRAFT
  OPEN
  CLOSED   // manually or automatically after closesAt
  ARCHIVED // retired; kept for response history (delete only while DRAFT)
}

// What a saved draft policy allows and what happens after submit.
enum DraftPolicy {
  SINGLE_DRAFT
  MULTIPLE_DRAFTS
}

enum AfterSubmitAction {
  SHOW_MESSAGE       // success content is part of the MDX
  REDIRECT_TO_PORTAL
}

model Form {
  id      String      @id @default(cuid())
  eventId String
  event   Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  purpose FormPurpose
  target  FormTarget  @default(SUBMISSION)

  internalName String // admin-facing
  publicTitle  String // submitter-facing
  slug         String // public URL: /submit/{event.slug}/{form.slug}
  status       FormStatus @default(DRAFT)

  // The live MDX (denormalized pointer to the latest FormVersion; new
  // responses snapshot this version).
  currentVersionId String?      @unique
  currentVersion   FormVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  closesAt        DateTime? // enables draft reminder emails
  submissionLimit Int? // per-user; null → Event.submissionLimitPerUser
  draftPolicy     DraftPolicy       @default(SINGLE_DRAFT)
  afterSubmit     AfterSubmitAction @default(SHOW_MESSAGE)

  // CFP routing default: submissions land in this evaluation plan unless the
  // chosen track overrides it via Track.evaluationPlanId.
  defaultEvaluationPlanId String?
  defaultEvaluationPlan   EvaluationPlan? @relation(fields: [defaultEvaluationPlanId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions               FormVersion[]
  notificationRecipients FormNotificationRecipient[]
  responses              FormResponse[]
  sessions               Session[] // submissions created through this form
  taskDefinitions        TaskDefinition[]
  reminderRules          ReminderRule[]

  @@unique([eventId, slug]) // slug is per-event ("cfp" can exist in every event)
  @@unique([id, eventId])
  @@index([eventId])
  @@index([defaultEvaluationPlanId])
}

// Immutable MDX snapshot, created on every save/publish from the editor.
// Replaces the old "lock structure after first submission" rule: editing just
// creates a new version, and each response keeps pointing at the exact MDX it
// was filled against (validation re-runs against that snapshot).
model FormVersion {
  id        String   @id @default(cuid())
  formId    String
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  mdxSource String   // the whole form: structure, copy, field props, logic
  createdAt DateTime @default(now())

  currentOf Form?          @relation("CurrentVersion")
  responses FormResponse[]

  @@index([formId, createdAt])
}

// Admin alert recipients per form.
enum NotificationTrigger {
  NEW_SUBMISSION
  UPDATED_SUBMISSION
}

model FormNotificationRecipient {
  id      String              @id @default(cuid())
  formId  String
  form    Form                @relation(fields: [formId], references: [id], onDelete: Cascade)
  userId  String
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  trigger NotificationTrigger

  @@unique([formId, userId, trigger])
  @@index([formId])
}

// ═════════════════════════════════════════════════════════════════════════════
// SPEAKERS — event-scoped people. userId nullable: co-speakers added by email
// link to a User when that person first signs into the portal (magic link).
// ═════════════════════════════════════════════════════════════════════════════

// Per-participation confirmation lives on SessionParticipant (a speaker can
// confirm one accepted talk and decline another). An event-level speaker
// status is DERIVED from their participations, never stored.
enum SpeakerConfirmation {
  PENDING   // accepted session but hasn't confirmed participation yet
  CONFIRMED
  DECLINED
}

model Speaker {
  id      String  @id @default(cuid())
  eventId String
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  email     String
  firstName String
  lastName  String
  // System profile fields (portal "Profile" page)
  bio           String? // rich text, <=5000 chars app-enforced
  jobTitle      String?
  companyName   String?
  phone         String?
  salutation    String?
  honorific     String?
  pronouns      String?
  gender        String?
  websiteUrl    String?
  linkedinUrl   String?
  twitterUrl    String?
  facebookUrl   String?
  headshotFileId String? @unique
  headshotFile   File?   @relation("SpeakerHeadshot", fields: [headshotFileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participations     SessionParticipant[]
  submittedSessions  Session[]
  availability       SpeakerAvailability[]
  taskAssignments    TaskAssignment[]
  formResponses      FormResponse[]
  subjectFieldValues FormFieldValue[] // per-participant values about this speaker
  emailMessages      EmailMessage[]
  uploadedFiles      File[]               @relation("UploadedBySpeaker")

  // + partial unique (eventId, userId) WHERE userId IS NOT NULL — one linked
  //   speaker identity per user per event (see header appendix).
  // Speakers with submitted history are anonymized, never hard-deleted.
  @@unique([eventId, email])
  @@unique([id, eventId])
  @@index([userId])
  @@index([eventId])
}

// Availability windows feeding agenda conflict detection ("flies out Friday").
enum AvailabilityKind {
  AVAILABLE   // only these windows are OK (whitelist mode)
  UNAVAILABLE // these windows are blocked (blacklist mode)
}

model SpeakerAvailability {
  id        String           @id @default(cuid())
  speakerId String
  speaker   Speaker          @relation(fields: [speakerId], references: [id], onDelete: Cascade)
  kind      AvailabilityKind @default(UNAVAILABLE)
  startsAt  DateTime
  endsAt    DateTime
  note      String?

  @@index([speakerId])
}

// ═════════════════════════════════════════════════════════════════════════════
// SUBMISSIONS / SESSIONS — one table for the whole lifecycle (mirrors the real
// SessionBoard API where a Session has is_abstract). stage=ABSTRACT while under
// review; promotion to stage=SESSION happens on acceptance.
// ═════════════════════════════════════════════════════════════════════════════

enum SessionStage {
  ABSTRACT // a proposal under review
  SESSION  // a finalized agenda item
}

enum SessionStatus {
  DRAFT         // submitter saved but not submitted
  PENDING       // submitted, awaiting decision
  ACCEPT_QUEUE  // shortlisted for acceptance (decision email not sent yet)
  ACCEPTED
  DECLINE_QUEUE // shortlisted for decline
  DECLINED
  WITHDRAWN     // pulled by the submitter
}

// CONTENT sessions carry speakers/CFP/evaluation; SERVICE sessions (breaks,
// lunch, registration, party) only use rooms/times/visibility in the grid.
enum SessionKind {
  CONTENT
  SERVICE
}

// PUBLIC sessions appear in embeds and the public agenda/feeds.
enum SessionVisibility {
  PUBLIC
  PRIVATE
}

model Session {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Human-readable id shown in UI/portal ("SESS-4"). Allocated atomically from
  // Event.nextSessionNumber (never SELECT max()+1 — race under concurrency).
  friendlyId Int

  // Provenance: null form = manually created by an admin.
  formId String?
  form   Form?   @relation(fields: [formId], references: [id], onDelete: SetNull)
  // The single source of truth for who submitted it (their portal User is
  // reachable via Speaker.userId). No duplicate submitter flags elsewhere.
  submitterSpeakerId String?
  submitterSpeaker   Speaker? @relation(fields: [submitterSpeakerId], references: [id], onDelete: SetNull)

  kind   SessionKind   @default(CONTENT)
  stage  SessionStage  @default(ABSTRACT)
  status SessionStatus @default(DRAFT)

  // Nullable so autosaved drafts can exist before the Title question is
  // answered. CHECK: non-DRAFT rows must have a non-empty title.
  title           String?
  description     String? // rich text
  clientSessionId String? // external system id
  capacity        Int?
  ceuCredits      Float?
  visibility      SessionVisibility @default(PRIVATE)
  // Public cover image the speaker can set from the portal.
  coverImageFileId String? @unique
  coverImageFile   File?   @relation("SessionCoverImage", fields: [coverImageFileId], references: [id], onDelete: SetNull)

  // Which evaluation plan reviews this submission (set by routing or admin).
  // Membership in individual rounds lives in RoundSession.
  evaluationPlanId String?
  evaluationPlan   EvaluationPlan? @relation(fields: [evaluationPlanId], references: [id], onDelete: SetNull)

  trackId    String?
  track      Track?    @relation(fields: [trackId], references: [id], onDelete: SetNull)
  formatId   String?
  format     Format?   @relation(fields: [formatId], references: [id], onDelete: SetNull)
  levelId    String?
  level      Level?    @relation(fields: [levelId], references: [id], onDelete: SetNull)
  languageId String?
  language   Language? @relation(fields: [languageId], references: [id], onDelete: SetNull)

  // Live schedule (null until placed via agenda). Draft placements live in
  // DraftPlacement and are copied here on commit. scheduleSlot is the optional
  // snap-to-slot reference; startsAt/endsAt stay the source of truth.
  roomId         String?
  room           Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  scheduleSlotId String?
  scheduleSlot   ScheduleSlot? @relation(fields: [scheduleSlotId], references: [id], onDelete: SetNull)
  startsAt       DateTime?
  endsAt         DateTime?

  // Lifecycle timestamps
  submittedAt DateTime? // DRAFT → PENDING
  decidedAt   DateTime? // → ACCEPTED / DECLINED
  notifiedAt  DateTime? // decision email sent ("Notified" column)
  withdrawnAt DateTime?

  // ICS SEQUENCE counter — bump on every schedule change to update invites.
  icsSequence Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags              SessionTag[]
  participants      SessionParticipant[]
  formResponses     FormResponse[]
  transitions       SessionTransition[]
  roundEntries      RoundSession[]
  reviewAssignments ReviewAssignment[]
  draftPlacements   DraftPlacement[]
  taskAssignments   TaskAssignment[]
  files             File[]               @relation("SessionFiles")
  emailMessages     EmailMessage[]

  @@unique([eventId, friendlyId])
  @@unique([id, eventId]) // target for composite tenant-boundary FKs
  @@index([eventId, status])
  @@index([eventId, stage])
  @@index([eventId, startsAt])
  @@index([eventId, roomId, startsAt])
  @@index([formId])
  @@index([submitterSpeakerId])
  @@index([trackId])
  @@index([evaluationPlanId])
  // BetterAuth owns the physical `session` table (akarso parity), so the
  // domain session entity lives in `event_session`.
  @@map("event_session")
}

// Append-only audit log of every stage/status change (who, when, why).
// Written in the same atomic batch as the change itself. Actor ids are
// snapshots (no FK) so history survives user deletion.
model SessionTransition {
  id         String        @id @default(cuid())
  sessionId  String
  session    Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  fromStage  SessionStage
  toStage    SessionStage
  fromStatus SessionStatus
  toStatus   SessionStatus
  actorUserId String? // null = system (e.g. auto-close, submitter portal action noted in reason)
  reason      String?
  occurredAt  DateTime     @default(now())

  @@index([sessionId, occurredAt])
}

model SessionTag {
  id        String  @id @default(cuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([sessionId, tagId])
  @@index([tagId])
}

// Speakers/chairs/moderators on a session, with role, display order, and
// per-participation confirmation (a speaker can confirm talk A, decline B).
model SessionParticipant {
  id      String @id @default(cuid())
  eventId String // denormalized: session, speaker, and role must share the event
  sessionId         String
  session           Session         @relation(fields: [sessionId, eventId], references: [id, eventId], onDelete: Cascade)
  speakerId         String
  speaker           Speaker         @relation(fields: [speakerId, eventId], references: [id, eventId], onDelete: Cascade)
  participantRoleId String
  participantRole   ParticipantRole @relation(fields: [participantRoleId, eventId], references: [id, eventId], onDelete: Restrict)

  confirmationStatus SpeakerConfirmation @default(PENDING)
  confirmedAt        DateTime?
  declinedAt         DateTime?
  sortOrder          Int                 @default(0)
  createdAt          DateTime            @default(now())

  @@unique([sessionId, speakerId, participantRoleId])
  @@index([speakerId])
  @@index([participantRoleId])
}

// ═════════════════════════════════════════════════════════════════════════════
// FORM RESPONSES — the immutable record of a form fill. CFP responses create a
// Session; portal responses complete a TaskAssignment. On submit, well-known
// names are copied to typed entity columns (Session.title, Speaker.bio, ...);
// every other name stays here as FormFieldValue KV rows — that IS the custom
// data (no separate entity field-value tables; the latest submitted response
// is the source of truth for custom fields).
// ═════════════════════════════════════════════════════════════════════════════

enum ResponseStatus {
  DRAFT
  SUBMITTED
}

model FormResponse {
  id        String         @id @default(cuid())
  formId    String
  // Restrict: forms with responses are archived, never deleted — the response
  // record is the immutable evidence of what was submitted.
  form      Form           @relation(fields: [formId], references: [id], onDelete: Restrict)
  // The exact MDX snapshot this response was filled against. Validation and
  // rendering of past responses always use this version, never the live one.
  formVersionId String
  formVersion   FormVersion @relation(fields: [formVersionId], references: [id], onDelete: Restrict)
  // Respondent (the portal speaker filling it in). Restrict: anonymize
  // speakers instead of deleting once history exists.
  speakerId String
  speaker   Speaker        @relation(fields: [speakerId], references: [id], onDelete: Restrict)
  // CFP: the Session created by this response. Portal SUBMISSION forms: the
  // session the response is about. Portal SPEAKER forms: null.
  sessionId String?
  session   Session?       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // Portal responses opened from a task.
  taskAssignmentId String?          @unique
  taskAssignment   TaskAssignment?  @relation(fields: [taskAssignmentId], references: [id], onDelete: SetNull)

  status      ResponseStatus @default(DRAFT)
  submittedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  fieldValues   FormFieldValue[]
  emailMessages EmailMessage[]

  @@index([formId, status])
  @@index([formVersionId])
  @@index([speakerId])
  @@index([sessionId])
}

// One row per submitted field value. `name` is the component's name prop —
// the data contract between the MDX and the database. Everything a form posts
// is a string; well-known names are ALSO copied to typed entity columns on
// submit (library choices like "track" store the library row id as value and
// resolve through Session.trackId — the typed column is the FK-checked copy).
// Multi-select = multiple rows with the same name, one per selected value.
model FormFieldValue {
  id         String       @id @default(cuid())
  responseId String
  response   FormResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  name       String // "title", "track", "speaker.bio", "gpuNeeds", ...
  value      String
  // File-upload fields also link the uploaded File row.
  fileId     String?
  file       File?        @relation(fields: [fileId], references: [id], onDelete: SetNull)
  // For fields inside <Participants>: which participant this value describes.
  // App-validated: must be a participant of the response's session. Restrict:
  // anonymize speakers, never destroy response history.
  subjectSpeakerId String?
  subjectSpeaker   Speaker? @relation(fields: [subjectSpeakerId], references: [id], onDelete: Restrict)

  // Uniqueness via TWO partial indexes (see header appendix) — a plain
  // composite unique fails in SQLite because NULL subjectSpeakerId rows
  // are always considered distinct.
  @@index([responseId, name])
  @@index([subjectSpeakerId])
  @@index([fileId])
}

// ═════════════════════════════════════════════════════════════════════════════
// EVALUATION — round-based plans with scorecards, reviewer assignments, scores.
// ═════════════════════════════════════════════════════════════════════════════

enum PlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

model EvaluationPlan {
  id      String     @id @default(cuid())
  eventId String
  event   Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name    String // "My Evaluation Plan"
  status  PlanStatus @default(DRAFT)

  createdAt DateTime @default(now())

  rounds        EvaluationRound[]
  sessions      Session[] // submissions routed into this plan
  tracks        Track[]   // tracks that route into this plan
  defaultForForms Form[]  // forms using this plan as routing default

  @@unique([id, eventId])
  @@index([eventId])
}

enum RoundStatus {
  PENDING
  OPEN
  CLOSED
}

enum Anonymization {
  NONE         // reviewers see speaker identities
  SINGLE_BLIND // reviewers don't see speakers
}

model EvaluationRound {
  id     String         @id @default(cuid())
  planId String
  plan   EvaluationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  name   String // "Initial Review", "Committee Decision"
  sortOrder Int         @default(0)

  status        RoundStatus   @default(PENDING)
  anonymization Anonymization @default(NONE)
  opensAt       DateTime?
  closesAt      DateTime?
  // Assignment caps used by the auto-assignment tool.
  maxReviewsPerSubmission Int?
  maxReviewsPerReviewer   Int?

  scorecardFields ScorecardField[]
  roundSessions   RoundSession[]
  assignments     ReviewAssignment[]
  reviewerPool    EvaluationRoundReviewer[]

  @@unique([id, planId])
  @@index([planId])
}

// Per-round reviewer pool — auto-assignment only picks from this list.
// (SessionBoard: "each round has its own reviewer pool".)
model EvaluationRoundReviewer {
  id         String          @id @default(cuid())
  roundId    String
  round      EvaluationRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User            @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  @@unique([roundId, reviewerId])
  @@index([reviewerId])
}

// Which submissions are in a round and whether they advanced.
enum RoundOutcome {
  PENDING
  ADVANCED // moved to the next round (next RoundSession inserted atomically)
  REJECTED // dropped from the plan (admin then sets DECLINE_QUEUE)
}

model RoundSession {
  id      String @id @default(cuid())
  roundId String
  round   EvaluationRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  outcome   RoundOutcome @default(PENDING)
  // Outcome audit (actor id is a snapshot, no FK — survives user deletion).
  outcomeDecidedAt   DateTime?
  outcomeDecidedById String?
  outcomeComment     String?

  @@unique([roundId, sessionId])
  @@index([sessionId])
  @@index([roundId, outcome])
}

// Presets built on these primitives (product-level, not schema-level):
//   "Quick vote"      → one DROPDOWN: Yes / Maybe / No
//   "Stars"           → one RATING 1..10 rendered as half-stars
//   "Weighted rubric" → several RATING fields with weights
enum ScoreFieldType {
  RATING   // numeric scale minScore..maxScore
  TEXT     // free-text feedback
  DROPDOWN
  YES_NO
  FILE     // reviewer uploads a marked-up document
}

model ScorecardField {
  id      String          @id @default(cuid())
  roundId String
  round   EvaluationRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  label   String // "Relevance", "Speaker experience"
  fieldType ScoreFieldType
  required  Boolean       @default(true)
  minScore  Int? // RATING
  maxScore  Int? // RATING
  weight    Float @default(1) // weighted average across fields
  sortOrder Int   @default(0)

  options ScorecardFieldOption[]
  scores  ReviewScore[]

  @@unique([id, roundId]) // target for same-round composite FKs
  @@index([roundId])
}

model ScorecardFieldOption {
  id               String         @id @default(cuid())
  scorecardFieldId String
  scorecardField   ScorecardField @relation(fields: [scorecardFieldId], references: [id], onDelete: Cascade)
  label            String
  // Numeric contribution of this option to the weighted score, if any.
  scoreValue       Float?
  sortOrder        Int            @default(0)

  scores ReviewScore[]

  @@unique([id, scorecardFieldId]) // target for option-belongs-to-field FKs
  @@index([scorecardFieldId])
}

enum AssignmentStatus {
  PENDING              // assigned, not started
  IN_PROGRESS
  COMPLETED
  DECLINED             // reviewer opted out
  CONFLICT_OF_INTEREST // reviewer declared COI; excluded from averages
}

// One reviewer reviewing one submission in one round. The review itself is
// folded into the assignment (status, comment, scores).
model ReviewAssignment {
  id         String          @id @default(cuid())
  roundId    String
  round      EvaluationRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  sessionId  String
  session    Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User            @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  status         AssignmentStatus @default(PENDING)
  overallComment String?
  // COI audit — set when status becomes CONFLICT_OF_INTEREST.
  coiReason      String?
  coiDeclaredAt  DateTime?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())

  scores ReviewScore[]

  @@unique([roundId, sessionId, reviewerId])
  @@unique([id, roundId]) // target for same-round composite FKs
  @@index([reviewerId, status])
  @@index([sessionId])
  @@index([roundId, status])
}

model ReviewScore {
  id           String @id @default(cuid())
  roundId      String // denormalized: assignment and scorecard field must share the round
  assignmentId String
  assignment   ReviewAssignment @relation(fields: [assignmentId, roundId], references: [id, roundId], onDelete: Cascade)
  scorecardFieldId String
  // Restrict: used scorecard fields are archived, never deleted.
  scorecardField ScorecardField @relation(fields: [scorecardFieldId, roundId], references: [id, roundId], onDelete: Restrict)

  valueNumber      Float? // RATING / YES_NO (1|0)
  valueText        String? // TEXT
  selectedOptionId String? // DROPDOWN — composite: option must belong to the field
  selectedOption   ScorecardFieldOption? @relation(fields: [selectedOptionId, scorecardFieldId], references: [id, scorecardFieldId], onDelete: Restrict)
  valueFileId      String? // FILE
  valueFile        File?   @relation("ReviewScoreFile", fields: [valueFileId], references: [id], onDelete: SetNull)

  @@unique([assignmentId, scorecardFieldId])
  @@index([scorecardFieldId])
  @@index([selectedOptionId])
}

// ═════════════════════════════════════════════════════════════════════════════
// AGENDA — draft workspaces over the live schedule + typed scheduling rules.
// Conflicts are COMPUTED, never stored: time-overlap ∧ (same room ∨ shared
// participant ∨ speaker unavailable ∨ rule violation). There is NO waiver
// table — conflicts are always shown, and committing a draft with open
// conflicts requires an explicit confirmation in the UI.
// ═════════════════════════════════════════════════════════════════════════════

enum AgendaDraftStatus {
  OPEN
  COMMITTED
  DISCARDED
}

model AgendaDraft {
  id          String            @id @default(cuid())
  eventId     String
  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      AgendaDraftStatus @default(OPEN)
  // Optimistic concurrency: snapshot of Event.scheduleRevision when the draft
  // was created (or last rebased). Commit succeeds only if it still matches;
  // otherwise the draft must be rebased. Prevents two drafts silently
  // overwriting each other.
  baseScheduleRevision Int
  committedRevision    Int? // Event.scheduleRevision written by this commit
  committedByUserId    String? // snapshot, no FK
  committedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  placements DraftPlacement[]

  @@index([eventId])
}

// A staged placement: on commit, copied to Session.roomId/scheduleSlotId/
// startsAt/endsAt (and icsSequence bumped + updated calendar invites queued).
model DraftPlacement {
  id      String @id @default(cuid())
  draftId String
  draft   AgendaDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  eventId String // denormalized: session and room must share the event
  sessionId String
  session   Session @relation(fields: [sessionId, eventId], references: [id, eventId], onDelete: Cascade)
  roomId    String?
  room      Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)
  scheduleSlotId String?
  scheduleSlot   ScheduleSlot? @relation(fields: [scheduleSlotId], references: [id], onDelete: SetNull)
  startsAt  DateTime?
  endsAt    DateTime? // CHECK: both null or endsAt > startsAt (header appendix)
  // A placement with all-null room/slot/times means "unschedule this session".

  @@unique([draftId, sessionId])
  @@index([sessionId])
  @@index([roomId])
}

// Reduced to the checks that serve the use case; more types can come later.
enum SchedulingRuleType {
  SPEAKER_NO_OVERLAP   // same speaker in two overlapping sessions
  ROOM_NO_OVERLAP      // two sessions overlap in one room
  ROOM_CAPACITY_LIMIT  // session.capacity must not exceed room.capacity
  SPEAKER_AVAILABILITY // respect SpeakerAvailability windows
  MIN_BUFFER_MINUTES   // intValue = required gap between sessions (scoped)
}

model SchedulingRule {
  id      String             @id @default(cuid())
  eventId String
  event   Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name    String
  type    SchedulingRuleType
  status  RuleStatus         @default(ENABLED)
  intValue Int? // meaning depends on type (see enum comments)
  // Optional scoping — rule applies only to this room if set.
  roomId  String?
  room    Room?              @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// ═════════════════════════════════════════════════════════════════════════════
// SPEAKER PORTAL — onboarding tasks, file requests, files.
// ═════════════════════════════════════════════════════════════════════════════

enum TaskTarget {
  SPEAKER    // one assignment per speaker ("book your hotel")
  SUBMISSION // one assignment per accepted session ("upload slides")
}

// Source ↔ link consistency (CHECK in migration + app validation):
//   MANUAL       → formId NULL,     fileRequestId NULL
//   FORM         → formId NOT NULL, fileRequestId NULL (form.target must match task target)
//   FILE_REQUEST → formId NULL,     fileRequestId NOT NULL (same target rule)
enum TaskSource {
  MANUAL       // checkbox task, speaker marks complete
  FORM         // completing the linked portal Form completes the task
  FILE_REQUEST // uploading to the linked FileRequest completes the task
}

// AUTO_ON_ACCEPT tasks are assigned to every accepted speaker/session when
// they reach ACCEPTED; MANUAL tasks are assigned by hand.
enum TaskAssignmentMode {
  AUTO_ON_ACCEPT
  MANUAL
}

model TaskDefinition {
  id      String     @id @default(cuid())
  eventId String
  event   Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title   String
  instructionsHtml String?
  target  TaskTarget
  source  TaskSource @default(MANUAL)

  formId        String?
  form          Form?        @relation(fields: [formId], references: [id], onDelete: SetNull)
  fileRequestId String?
  fileRequest   FileRequest? @relation(fields: [fileRequestId], references: [id], onDelete: SetNull)

  dueAt     DateTime? // default for NEW assignments (snapshotted per assignment)
  assignmentMode TaskAssignmentMode @default(AUTO_ON_ACCEPT)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  assignments   TaskAssignment[]
  reminderRules ReminderRule[]

  @@unique([id, eventId])
  @@index([eventId])
  @@index([formId])
  @@index([fileRequestId])
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS // draft response / partial upload exists
  SUBMITTED   // awaiting admin review (form/file tasks)
  COMPLETED
}

// The per-speaker (or per-session) instance of a task. This table IS the
// "outstanding onboarding tasks" dashboard.
model TaskAssignment {
  id      String @id @default(cuid())
  eventId String // denormalized: definition, speaker, session share the event
  taskDefinitionId String
  taskDefinition   TaskDefinition @relation(fields: [taskDefinitionId, eventId], references: [id, eventId], onDelete: Cascade)
  speakerId        String
  speaker          Speaker        @relation(fields: [speakerId, eventId], references: [id, eventId], onDelete: Cascade)
  // Set when target = SUBMISSION. (Composite event FK added in drizzle —
  // Prisma can't mix a required eventId with a nullable sessionId.)
  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  status      TaskStatus @default(NOT_STARTED)
  // Snapshot of TaskDefinition.dueAt at assignment time — later definition
  // edits don't silently move deadlines for already-assigned speakers.
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  formResponse  FormResponse?
  files         File[]        @relation("TaskFiles")
  emailMessages EmailMessage[]

  // Uniqueness via TWO partial indexes (see header appendix) — a plain
  // composite unique fails for speaker tasks because sessionId is NULL and
  // SQLite treats NULLs as distinct. Assignment creation on acceptance is
  // idempotent (ON CONFLICT DO NOTHING against these indexes).
  @@index([taskDefinitionId, status])
  @@index([speakerId, status])
  @@index([sessionId])
}

enum FileRequestTarget {
  SPEAKER
  SUBMISSION
}

model FileRequest {
  id               String            @id @default(cuid())
  eventId          String
  event            Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title            String // "Upload Presentation Slides"
  instructionsHtml String?
  target           FileRequestTarget
  createdAt        DateTime          @default(now())

  taskDefinitions TaskDefinition[]
  files           File[]

  @@unique([id, eventId])
  @@index([eventId])
}

enum FileKind {
  HEADSHOT
  SLIDES
  DOCUMENT
  IMAGE
  OTHER
}

// Bytes live in object storage; this row is metadata + ownership links.
// Ownership rule: the EVENT owns every file (deleting the event deletes its
// files + storage bytes). Deleting a session/task/answer only CLEARS the
// attachment (SetNull) — a background job garbage-collects rows with no
// remaining references and deletes the storage bytes. A file serves exactly
// one purpose (a HEADSHOT is never also a logo) — app-enforced via `kind`.
model File {
  id      String   @id @default(cuid())
  eventId String
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind    FileKind @default(OTHER)

  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String @unique // object-storage key (R2/S3/disk)

  uploadedBySpeakerId String?
  uploadedBySpeaker   Speaker? @relation("UploadedBySpeaker", fields: [uploadedBySpeakerId], references: [id], onDelete: SetNull)
  // What the file is attached to (any may be null).
  sessionId        String?
  session          Session?        @relation("SessionFiles", fields: [sessionId], references: [id], onDelete: SetNull)
  fileRequestId    String?
  fileRequest      FileRequest?    @relation(fields: [fileRequestId], references: [id], onDelete: SetNull)
  taskAssignmentId String?
  taskAssignment   TaskAssignment? @relation("TaskFiles", fields: [taskAssignmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  // Reverse links for typed usages
  eventLogoOf       Event?           @relation("EventLogo")
  eventBackgroundOf Event?           @relation("EventBackground")
  speakerHeadshotOf Speaker?         @relation("SpeakerHeadshot")
  sessionCoverOf    Session?         @relation("SessionCoverImage")
  formFieldValues   FormFieldValue[]
  reviewScores      ReviewScore[]    @relation("ReviewScoreFile")

  @@index([eventId])
  @@index([sessionId])
  @@index([fileRequestId])
  @@index([taskAssignmentId])
  @@index([uploadedBySpeakerId])
}

// ═════════════════════════════════════════════════════════════════════════════
// EMAILS — templates, reminder rules, send log. Calendar invites are ICS
// attachments on SCHEDULE_INVITE emails; Session.icsSequence handles updates.
// ═════════════════════════════════════════════════════════════════════════════

enum EmailTemplateKey {
  SUBMISSION_CONFIRMATION // sent to submitter after CFP submit
  SUBMISSION_UPDATED      // sent when submitter edits a submission
  DECISION_ACCEPTED       // acceptance email (stamps Session.notifiedAt)
  DECISION_DECLINED
  TASK_ASSIGNED
  TASK_REMINDER           // task due soon / overdue
  DRAFT_REMINDER          // unfinished CFP draft before form closesAt
  SCHEDULE_INVITE         // calendar invite (ICS REQUEST) when session is scheduled
  SCHEDULE_UPDATE         // ICS REQUEST with bumped SEQUENCE when a session moves
  SCHEDULE_CANCEL         // ICS CANCEL when a session is unscheduled/withdrawn
  CUSTOM
}

enum TemplateStatus {
  ENABLED
  DISABLED
}

model EmailTemplate {
  id      String           @id @default(cuid())
  eventId String
  event   Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  key     EmailTemplateKey
  name    String
  status  TemplateStatus   @default(ENABLED)
  subject String
  // Handlebars-style body: {{speaker.firstName}}, {{session.title}},
  // {{event.name}}, {{task.dueAt}}, {{portalUrl}}...
  bodyHtml String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reminderRules ReminderRule[]
  messages      EmailMessage[]

  @@unique([eventId, key, name])
  @@index([eventId])
}

enum ReminderTrigger {
  TASK_DUE         // daysOffset before TaskAssignment.dueAt
  TASK_OVERDUE     // daysOffset after TaskAssignment.dueAt
  DRAFT_INCOMPLETE // daysOffset before Form.closesAt, to holders of DRAFT responses
}

// Scheduled automation: a cron scans rules and enqueues EmailMessages.
// Idempotency comes from EmailMessage.dedupeKey (unique insert wins), e.g.
//   "reminder:{ruleId}:{taskAssignmentId}:{yyyy-mm-dd}"
//   "reminder:{ruleId}:{formResponseId}:{yyyy-mm-dd}"
// Two concurrent cron workers cannot double-send.
model ReminderRule {
  id         String          @id @default(cuid())
  eventId    String
  event      Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  templateId String
  template   EmailTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  trigger    ReminderTrigger
  daysOffset Int             @default(1)
  status     RuleStatus      @default(ENABLED)
  // TASK_* triggers: scope to one task definition (null = all with due dates).
  taskDefinitionId String?
  taskDefinition   TaskDefinition? @relation(fields: [taskDefinitionId], references: [id], onDelete: Cascade)
  // DRAFT_INCOMPLETE trigger: which form's drafts (required for that trigger —
  // an event can run several CFP forms at once).
  formId String?
  form   Form?   @relation(fields: [formId], references: [id], onDelete: Cascade)

  messages EmailMessage[]

  @@index([eventId])
  @@index([templateId])
  @@index([taskDefinitionId])
  @@index([formId])
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

// ICS calendar attachment semantics. The calendar UID is stable and derived:
// "session-{sessionId}@{appDomain}" — never stored, never changes. Updates
// bump SEQUENCE (snapshot below); unschedule/withdraw sends CANCEL.
enum IcsMethod {
  REQUEST // invite or update
  CANCEL
}

// Transactional outbox + send log — one row per outbound email. A failed
// message is retried on the SAME row (attemptCount), never re-inserted.
model EmailMessage {
  id         String         @id @default(cuid())
  eventId    String
  event      Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  templateId String?
  template   EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  // Idempotency: unique insert is the dedupe mechanism (see ReminderRule).
  // Non-reminder sends use keys like "decision:{sessionId}:{speakerId}" or
  // "ics:{sessionId}:{speakerId}:{icsSequence}".
  dedupeKey String @unique

  toEmail   String
  speakerId String?
  speaker   Speaker? @relation(fields: [speakerId], references: [id], onDelete: SetNull)
  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  // Provenance links for reminder/task/draft emails.
  reminderRuleId   String?
  reminderRule     ReminderRule?   @relation(fields: [reminderRuleId], references: [id], onDelete: SetNull)
  taskAssignmentId String?
  taskAssignment   TaskAssignment? @relation(fields: [taskAssignmentId], references: [id], onDelete: SetNull)
  formResponseId   String?
  formResponse     FormResponse?   @relation(fields: [formResponseId], references: [id], onDelete: SetNull)

  subject  String
  bodyHtml String // rendered snapshot
  // ICS attachment (null = plain email). Sequence is snapshotted from
  // Session.icsSequence at enqueue time.
  icsMethod   IcsMethod?
  icsSequence Int?

  status        EmailStatus @default(QUEUED)
  attemptCount  Int         @default(0)
  lastAttemptAt DateTime?
  errorMessage  String?
  sentAt        DateTime?
  createdAt     DateTime    @default(now())

  @@index([eventId, status])
  @@index([speakerId])
  @@index([sessionId])
  @@index([reminderRuleId])
  @@index([taskAssignmentId])
}

// ═════════════════════════════════════════════════════════════════════════════
// EMBEDS — auto-updating agenda / speaker widgets for the event website.
// Served by a public token; only ACCEPTED sessions with visibility PUBLIC are
// exposed (same data source as the public JSON/ICS feeds).
// ═════════════════════════════════════════════════════════════════════════════

enum EmbedWidget {
  AGENDA
  SESSION_LIST
  SCHEDULE_ITINERARY
  SPEAKER_LIST
  SPEAKER_GALLERY
}

enum EmbedStatus {
  ENABLED
  DISABLED
}

enum EmbedGroupBy {
  DAY
  TRACK
  ROOM
}

model Embed {
  id          String      @id @default(cuid())
  eventId     String
  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  widget      EmbedWidget
  status      EmbedStatus @default(ENABLED)
  publicToken String      @unique // used in the <script>/iframe embed code

  // Display options (typed, not JSON)
  showSpeakerPhotos Boolean      @default(true)
  showTrackColors   Boolean      @default(true)
  groupBy           EmbedGroupBy @default(DAY)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  filters EmbedFilter[]

  @@index([eventId])
}

// Normalized content filters — one row per included track/tag/format, with
// EXACTLY ONE dimension set per row (CHECK in migration). No rows of a given
// dimension = no filtering on that dimension. Duplicate rows are prevented by
// per-dimension partial unique indexes in the migration.
model EmbedFilter {
  id       String  @id @default(cuid())
  embedId  String
  embed    Embed   @relation(fields: [embedId], references: [id], onDelete: Cascade)
  trackId  String?
  track    Track?  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  tagId    String?
  tag      Tag?    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  formatId String?
  format   Format? @relation(fields: [formatId], references: [id], onDelete: Cascade)

  @@index([embedId])
  @@index([trackId])
  @@index([tagId])
  @@index([formatId])
}
