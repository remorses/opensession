{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "opensession-website",
  "main": "spiceflow/cloudflare-entrypoint",
  "workers_dev": true,
  "compatibility_date": "2026-06-02",
  "compatibility_flags": ["nodejs_compat"],
  "placement": { "mode": "smart" },

  // ── Production (top-level) ──────────────────────────────────────────
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opensession-db",
      "database_id": "b6282777-9a6f-4f6b-af76-8e57d1cb1749",
      "migrations_dir": "../db/drizzle",
      "migrations_pattern": "../db/drizzle/*/migration.sql"
    }
  ],
  // Production serves the real domain. custom_domain creates the DNS record.
  "routes": [{ "pattern": "opensession.dev", "custom_domain": true }],
  "vars": {
    "APP_URL": "https://opensession.dev"
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "BETTER_AUTH_URL",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET"
    ]
  },

  // ── Preview ─────────────────────────────────────────────────────────
  // Bindings are NOT inherited — must duplicate everything here
  "env": {
    "preview": {
      "name": "opensession-website-preview",
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "opensession-preview-db",
          "database_id": "ef841c1a-2ce6-4a18-957b-072d2258c448",
          "migrations_dir": "../db/drizzle",
          "migrations_pattern": "../db/drizzle/*/migration.sql"
        }
      ],
      // Routes ARE inherited — preview must clear them or it would steal
      // opensession.dev from production. Preview lives on workers.dev.
      "routes": [],
      "vars": {
        "APP_URL": "https://opensession-website-preview.remorses.workers.dev"
      },
      "secrets": {
        "required": [
          "BETTER_AUTH_SECRET",
          "BETTER_AUTH_URL",
          "GOOGLE_CLIENT_ID",
          "GOOGLE_CLIENT_SECRET"
        ]
      }
    }
  }
}
