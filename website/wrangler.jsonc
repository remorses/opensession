{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "opensession-website",
  "main": "spiceflow/cloudflare-entrypoint",
  "workers_dev": true,
  "compatibility_date": "2026-06-02",
  "compatibility_flags": ["nodejs_compat"],
  "placement": { "mode": "smart" },

  // ── Production (top-level) ──────────────────────────────────────────
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opensession-db",
      "database_id": "a852e3f7-b62b-4915-ad2a-382bd46b95b2",
      "migrations_dir": "../db/drizzle",
      "migrations_pattern": "../db/drizzle/*/migration.sql"
    }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "opensession-files" }
  ],
  // opensession.dev is onboarded to Cloudflare Email Sending, so any local part
  // @opensession.dev is a legal sender. remote:true makes `vite dev` hit the real
  // service instead of the local simulator.
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true,
      "allowed_sender_addresses": ["notifications@opensession.dev"]
    }
  ],
  // Drains the email outbox, closes forms past closesAt, enqueues reminders,
  // and GCs unreferenced R2 objects. See src/lib/emails/cron.ts.
  "triggers": { "crons": ["*/5 * * * *"] },
  // Production serves the real domain. custom_domain creates the DNS record.
  "routes": [{ "pattern": "opensession.dev", "custom_domain": true }],
  "vars": {
    "APP_URL": "https://opensession.dev"
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "BETTER_AUTH_URL",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET"
    ]
  },

  // ── Preview ─────────────────────────────────────────────────────────
  // Bindings are NOT inherited — must duplicate everything here
  "env": {
    "preview": {
      "name": "opensession-website-preview",
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "opensession-preview-db",
          "database_id": "4169078f-7abe-48b5-88c2-6394a32115a4",
          "migrations_dir": "../db/drizzle",
          "migrations_pattern": "../db/drizzle/*/migration.sql"
        }
      ],
      "r2_buckets": [
        { "binding": "FILES", "bucket_name": "opensession-preview-files" }
      ],
      "send_email": [
        {
          "name": "EMAIL",
          "remote": true,
          "allowed_sender_addresses": ["notifications@opensession.dev"]
        }
      ],
      "triggers": { "crons": ["*/5 * * * *"] },
      // Routes ARE inherited — preview must set its own host or it steals
      // opensession.dev from production.
      "routes": [
        {
          "pattern": "preview.opensession.dev",
          "custom_domain": true,
          "zone_name": "opensession.dev"
        }
      ],
      "vars": {
        "APP_URL": "https://preview.opensession.dev"
      },
      "secrets": {
        "required": [
          "BETTER_AUTH_SECRET",
          "BETTER_AUTH_URL",
          "GOOGLE_CLIENT_ID",
          "GOOGLE_CLIENT_SECRET"
        ]
      }
    }
  }
}
