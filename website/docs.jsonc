{
  "$schema": "https://holocron.so/docs.json",
  "name": "OpenSession",
  "description": "Open-source speaker and session management: CFP forms, abstract review, agenda builder, and a speaker portal.",
  "colors": {
    "primary": "#5edceb"
  },
  "appearance": {
    "default": "dark"
  },
  "icons": { "library": "lucide" },
  // App routes served by the same worker — the broken-link checker only
  // sees .mdx pages, so anything the landing page links to must be here.
  "knownPaths": ["/login", "/login/*", "/dashboard", "/invite/*", "/org", "/org/*", "/submit/*", "/portal/*", "/embed/*", "/public/*", "/api/*", "/files/*", "/docs/api", "/docs/api/*"],
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "/dashboard"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Login with Google",
      "href": "/login/google"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Home",
        "icon": "lucide:home",
        "groups": [
          {
            "group": "Overview",
            "icon": "lucide:rocket",
            "pages": ["index"]
          },
          {
            "group": "Features",
            "icon": "lucide:layers",
            "pages": [
              "features/call-for-papers",
              "features/abstract-review",
              "features/agenda-builder",
              "features/speaker-portal",
              "features/emails-and-calendar"
            ]
          },
          {
            "group": "Compare",
            "icon": "lucide:scale",
            "pages": [
              "compare/vs-sessionboard",
              "compare/vs-sessionize"
            ]
          },
          {
            "group": "Guides",
            "icon": "lucide:book-open",
            "pages": ["guides/self-hosting"]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "lucide:code",
        "openapi": "openapi.json",
        "base": "/docs/api"
      },
      {
        "tab": "GitHub",
        "icon": "lucide:github",
        "href": "https://github.com/remorses/opensession"
      }
    ]
  }
}
