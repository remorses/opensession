{
  "$schema": "https://holocron.so/docs.json",
  "name": "OpenSession",
  "description": "Open-source speaker and session management: CFP forms, abstract review, agenda builder, and a speaker portal.",
  "colors": {
    "primary": "#5edceb"
  },
  "appearance": {
    "default": "dark"
  },
  "icons": { "library": "lucide" },
  // App routes served by the same worker — the broken-link checker only
  // sees .mdx pages, so anything the landing page links to must be here.
  "knownPaths": ["/login", "/login/*", "/dashboard", "/invite/*", "/org", "/org/*", "/submit/*", "/portal/*", "/embed/*", "/public/*", "/api/*", "/files/*"],
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/remorses/opensession"
      },
      {
        "label": "Dashboard",
        "href": "/dashboard"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Login with Google",
      "href": "/login/google"
    }
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/remorses/opensession",
          "icon": "lucide:github"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Home",
        "icon": "lucide:home",
        "groups": [
          {
            "group": "Overview",
            "icon": "lucide:rocket",
            "pages": ["index"]
          }
        ]
      },
      {
        "tab": "Features",
        "icon": "lucide:layers",
        "groups": [
          {
            "group": "Core Features",
            "icon": "lucide:sparkles",
            "pages": [
              "features/call-for-papers",
              "features/abstract-review",
              "features/agenda-builder",
              "features/speaker-portal",
              "features/emails-and-calendar"
            ]
          }
        ]
      },
      {
        "tab": "Compare",
        "icon": "lucide:scale",
        "groups": [
          {
            "group": "Alternatives",
            "icon": "lucide:arrow-left-right",
            "pages": ["compare/vs-sessionboard"]
          }
        ]
      },
      {
        "tab": "Guides",
        "icon": "lucide:book-open",
        "groups": [
          {
            "group": "Setup",
            "icon": "lucide:wrench",
            "pages": ["guides/self-hosting"]
          }
        ]
      }
    ]
  }
}
